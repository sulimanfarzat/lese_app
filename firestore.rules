rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Ist dieses Handy Mitglied der Familie?
    function isMember(code) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(code)).data.members;
    }

    // Jedes Handy merkt sich hier, zu welcher Familie es gehört.
    match /devices/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{code} {
      // Einzelnes Lesen mit bekanntem Code (zum Beitreten) – Auflisten aller Familien ist verboten.
      allow get: if signedIn();
      allow list: if false;

      // Neue Familie: das anlegende Handy muss Mitglied sein.
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      // Mitglieder dürfen alles ändern.
      allow update: if isMember(code)
        // Beitreten: Nicht-Mitglied darf sich nur selbst zur Mitgliederliste hinzufügen.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members);

      allow delete: if false;

      match /children/{childId} {
        allow read, create, delete: if isMember(code);
        // Ein Rekord kann nur steigen – nie verloren gehen.
        allow update: if isMember(code)
          && request.resource.data.get('bestWpm', 0) >= resource.data.get('bestWpm', 0);

        match /sessions/{sessionId} {
          allow read, delete: if isMember(code);
          // Plausibilitätsprüfung: max. 300 Wörter in einer Minute.
          allow create, update: if isMember(code)
            && request.resource.data.words is int
            && request.resource.data.words >= 0
            && request.resource.data.words <= 300;
        }
      }

      match /rewards/{rewardId} {
        allow read, write: if isMember(code);
      }
    }
  }
}
